# Plantilla de variables de entorno (sin secretos reales).
#
# Uso:
#   cp env.example .env.local    # desarrollo local (ya ignorado por Git)
#   docker compose --env-file env.example up -d   # solo para probar el compose
#
# En producción define estas variables en el panel del proveedor; no subas el
# fichero con valores reales al repositorio.

# --- Aplicación ---------------------------------------------------------------
NEXO_ENV=development
# SQLite por defecto (var/nexo.db). En producción, PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/nexo
NEXO_ALLOW_REGISTRATION=true
NEXO_CORS_ORIGINS=*

# --- SEC EDGAR ----------------------------------------------------------------
# La SEC exige un contacto identificable en el User-Agent. Sin este valor el
# motor no descarga datos y la API responde 503 con un mensaje explicativo.
NEXO_SEC_CONTACT=tu-correo@dominio.com
NEXO_SEC_CACHE_DIR=.sec_cache

# --- Proveedores de IA (opcionales) ------------------------------------------
# Sin claves, la aplicación funciona en modo básico: informe del motor sin
# análisis cualitativo. Las claves solo se leen en el servidor.
NEXO_AI_OPENAI_KEY=
NEXO_AI_OPENAI_MODEL=gpt-4o-mini
NEXO_AI_OPENAI_MODEL_STRONG=gpt-4o
NEXO_AI_ANTHROPIC_KEY=
NEXO_AI_ANTHROPIC_MODEL=claude-3-5-haiku
NEXO_AI_GEMINI_KEY=
NEXO_AI_GEMINI_MODEL=gemini-2.0-flash
# Servidor compatible con la API de OpenAI (vLLM, Ollama, LM Studio…)
NEXO_AI_LOCAL_BASE_URL=
NEXO_AI_LOCAL_MODEL=local

# --- Límites y presupuesto ----------------------------------------------------
NEXO_MONTHLY_BUDGET_USD=10
NEXO_DEFAULT_JOB_BUDGET_USD=0.50
NEXO_MAX_JOB_BUDGET_USD=5.00
NEXO_RATE_LIMIT_PER_MINUTE=120
NEXO_JOBS_PER_HOUR=10
NEXO_MAX_CONCURRENT_JOBS=2
NEXO_SESSION_TTL_HOURS=72
